<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tasknavi</groupId>
    <artifactId>TaskNavi</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 配布用 exe に付ける版（jpackage は数字と . だけ受け付ける） -->
        <app.version>1.2.0</app.version>
        <!-- -DskipTests で上書きされる。テストを飛ばしたときは割合の確認も飛ばす -->
        <skipTests>false</skipTests>
    </properties>

    <dependencies>
        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>

        <!-- Logback (SLF4Jの実装) -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.16</version>
        </dependency>
        <!-- SQLite JDBC Driver -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
        </dependency>

        <dependency>
            <groupId>com.miglayout</groupId>
            <artifactId>miglayout-swing</artifactId>
            <version>11.3</version>
        </dependency>
        <!-- Gson for JSON processing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- Flyway for database migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>10.22.0</version>
        </dependency>

        <!-- JUnit 5 for unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Fat-JAR (依存ライブラリをまとめたJAR) を作成するプラグイン -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                            <archive>
                                <manifest>
                                    <!-- メイン関数があるクラスを指定 -->
                                    <mainClass>org.tasknavi.Main</mainClass>
                                </manifest>
                                <!-- 画面とログに出す版（AppVersion が読む） -->
                                <manifestEntries>
                                    <Implementation-Version>${app.version}</Implementation-Version>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire plugin for running JUnit 5 tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <!-- テストが %APPDATA% の本物の DB に触れないようにする -->
                        <tasknavi.dataDir>${project.build.directory}/test-data</tasknavi.dataDir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- テストが通った行の割合: mvn test で target/site/jacoco/index.html（と jacoco.csv）ができる -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- mvn verify（CI）で、割合が下がっていたら止める。1つのテストだけ動かす mvn test では見ない -->
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- 共有の記録の読み書き。壊れるとチーム全員のデータに響く -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>org.tasknavi.team</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- IDE / CLI: mvn exec:java （mainClass はここに寄せる） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>org.tasknavi.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          配布用フォルダと zip を作る（Windows 用）: mvn -Pdist -DskipTests verify
          出来上がり: target/jpackage/dist/TaskNavi/TaskNavi.exe と target/TaskNavi-*-windows.zip
          Java ごと入るので、使うパソコンに Java は要らない。
        -->
        <profile>
            <id>dist</id>
            <properties>
                <jpackage.dir>${project.build.directory}/jpackage</jpackage.dir>
            </properties>
            <build>
                <plugins>
                    <!-- 1. 前回の出力を消す（jpackage は出力先が残っていると止まる） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>clean-jpackage</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${jpackage.dir}</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2. package で作った依存込み JAR だけを jpackage の入力フォルダへ写す -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>copy-jpackage-input</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${jpackage.dir}/input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}-jar-with-dependencies.jar</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 3. jpackage で TaskNavi.exe と、必要な分だけの Java を入れたフォルダを作る -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage.exe</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>TaskNavi</argument>
                                        <argument>--app-version</argument>
                                        <argument>${app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>TaskNavi</argument>
                                        <argument>--input</argument>
                                        <argument>${jpackage.dir}/input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}-jar-with-dependencies.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>org.tasknavi.Main</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/packaging/TaskNavi.ico</argument>
                                        <argument>--dest</argument>
                                        <argument>${jpackage.dir}/dist</argument>
                                        <!-- jdeps で調べた分 + 日本語の日付表示・文字コード・暗号・ライブラリが裏で使う分 -->
                                        <argument>--add-modules</argument>
                                        <argument>java.base,java.desktop,java.naming,java.prefs,java.sql,java.management,jdk.unsupported,jdk.localedata,jdk.charsets,jdk.crypto.ec</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-man-pages --no-header-files --strip-native-commands --include-locales=ja,en</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=UTF-8</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 4. 出来たフォルダを zip にまとめる -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>dist-zip</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/packaging/dist-zip.xml</descriptor>
                                    </descriptors>
                                    <finalName>TaskNavi-${app.version}</finalName>
                                    <attach>false</attach>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>